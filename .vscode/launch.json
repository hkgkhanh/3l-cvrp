{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run 3L-CVRP (MinGW GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "-i",
                "${workspaceFolder}/data/input/3l-cvrp/",
                "-f",
                "E016-03m.json",
                "-o",
                "${workspaceFolder}/my-runs/output/",
                "-p",
                "${workspaceFolder}/data/input/3l-cvrp/parameters/BenchmarkParameters_AllConstraints.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe"
        }
    ]
}